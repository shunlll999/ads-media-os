POSTGRES_PASSWORD=replace-with-local-password
GATEWAY_API_KEY=replace-with-local-api-key
DOCKER_WEB_PORT=3001
GATEWAY_PORT=4000
POSTGRES_PORT=5433
SEED_DEMO=true

# Only needed when starting Node directly outside Compose:
# DATABASE_URL=postgresql://media_os:your-password@127.0.0.1:5433/media_os

# Generated by npm run gateway:setup; keep these values private.
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@media-os.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# Hosts permitted for public project metadata sync; use your own allowlist locally.
PROJECT_PUBLIC_HOSTS=example.com
BOOTSTRAP_ADMIN_NAME=Administrator
