# Local frontend connection. Run npm run gateway:setup to generate private credentials.
MEDIA_OS_GATEWAY_URL=http://127.0.0.1:4000
MEDIA_OS_GATEWAY_API_KEY=replace-with-your-local-gateway-key

# Optional map provider. NEXT_PUBLIC values are visible in the browser bundle.
# NEXT_PUBLIC_MAP_TILE_URL=https://your-provider/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=Your provider attribution

# Optional public presentation values; keep owner-specific values in .env.local.
# NEXT_PUBLIC_WORKSPACE_BYLINE=Campaign workspace
# NEXT_PUBLIC_WORKSPACE_TITLE=Media OS — Campaign Workspace
# NEXT_PUBLIC_PORTFOLIO_AUTHOR=Example Author
# NEXT_PUBLIC_PORTFOLIO_URL=https://example.com
